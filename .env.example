ANALYZER_MODEL=r1-tester
WORKHORSE_MODEL=qwen-tester
ANALYZER_NUM_CTX=8192
WORKHORSE_NUM_CTX=4096
MAX_FILE_CHARS=60000
MAX_DIFF_LINES=200
MAX_FILES_TOUCHED=5
MAX_FIX_ATTEMPTS=3
HTTP_TIMEOUT=15.0
HTTP_RETRIES=1
CONCURRENCY=4
BATCH_SIZE=100
VERIFY_PORT_OFFSET=1000
VERIFY_STARTUP_TIMEOUT=20.0
VERIFY_TIMEOUT=30.0
DATABASE_URL=sqlite+aiosqlite:///./api_tester.db
# For PostgreSQL in compose.yaml, use:
# DATABASE_URL=postgresql+asyncpg://api_tester:api_tester_local_password@localhost:5432/api_tester
AUDIT_ENABLED=true
AUDIT_MAX_CHARS=200000
